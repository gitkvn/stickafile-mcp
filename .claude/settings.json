{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/git-commit-guard.sh\"",
            "timeout": 10,
            "statusMessage": "git-commit-guard: checking branch"
          }
        ]
      }
    ]
  }
}
