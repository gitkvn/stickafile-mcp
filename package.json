{
  "name": "stickafile-mcp",
  "version": "0.1.0",
  "description": "MCP server that uploads a file from disk to a Stickafile portal and returns a shareable link. The bytes never enter the model's context.",
  "type": "module",
  "bin": { "stickafile-mcp": "src/index.js" },
  "files": ["src", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/safety.test.js test/startup.test.js && node test/e2e.js",
    "test:unit": "node --test test/safety.test.js test/startup.test.js",
    "test:e2e": "node test/e2e.js"
  },
  "keywords": ["mcp", "stickafile", "upload", "model-context-protocol"],
  "author": "Kavan Ravi <kvnrvi@gmail.com>",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/gitkvn/stickafile-mcp.git" },
  "homepage": "https://stickafile.com",
  "bugs": { "url": "https://github.com/gitkvn/stickafile-mcp/issues" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  }
}
