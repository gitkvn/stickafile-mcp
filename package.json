    "test": "node test/e2e.js"
  },
  "keywords": ["mcp", "stickafile", "upload", "model-context-protocol"],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  }
}
